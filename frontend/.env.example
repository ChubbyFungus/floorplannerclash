# API Configuration
REACT_APP_API_URL=http://localhost:3000/api

# vLLM Cloudflare Tunnel base URL.
# Quick Tunnels change per session; copy/paste your current value from cloudflared output.
# Must include /v1 or the client will add it automatically.
VITE_VLLM_BASE_URL=https://YOUR_TUNNEL.trycloudflare.com/v1

# If vLLM was started with --api-key, set it here; leave empty otherwise.
VITE_VLLM_KEY=

# DeepSeek API Configuration
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Feature Flags
VITE_ENABLE_3D_VIEWER=true
VITE_ENABLE_AI_CHAT=true

# Analytics
VITE_ANALYTICS_ID=

# Authentication
VITE_AUTH_DOMAIN=
VITE_AUTH_CLIENT_ID=
